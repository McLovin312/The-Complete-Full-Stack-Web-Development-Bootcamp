<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Public APIs</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>
  <body class="bg-light d-flex justify-content-center py-5">
    <main class="container bg-white p-4 p-md-5 rounded shadow-sm" style="max-width: 550px;">
      
      <% if (tempC !== null) { %>
        <div class="card text-center mb-4 border-primary">
          <div class="card-body">
            <h1 class="text-primary display-6 fw-bold">Current Temperature:</h1>
            <h1 class="text-primary display-6 fw-bold"> <%= tempF %>°F</h1>'
            <h1 class="text-primary display-6 fw-bold"> <%= tempC %>°C</h1>
            <% if (uvIndex !== null) { %>
              <h3 class="text-warning mt-2">UV Index: <%= uvIndex %></h3>
            <% } %>
          </div>
        </div>
      <% } %>

      <form action="/submit-coordinates" method="POST" class="mb-4">
        <div class="mb-3">
          <label for="lat" class="form-label fw-bold">Latitude:</label>
          <input type="number" id="lat" name="latitude" class="form-control bg-light" min="-90" max="90" step="any" required />
        </div>
        <div class="mb-3">
          <label for="lng" class="form-label fw-bold">Longitude:</label>
          <input type="number" id="lng" name="longitude" class="form-control bg-light" min="-180" max="180" step="any" required />
        </div>
        <button type="button" id="detect-btn" class="btn btn-outline-secondary w-100 mb-2">📍 Detect My Location</button>
        <button type="submit" class="btn btn-primary w-100">Get Weather & UV</button>
      </form>

      <hr class="my-4" />

      <form action="/joke" method="POST" class="mb-4">
          <button type="submit" class="btn btn-primary w-100">Tell me a Joke!</button>
      </form>

      <% if (joke !== null) { %>
        <div class="card text-center mb-4 border-info">
          <div class="card-body">
            <h2 class="h5 text-secondary m-0"><%= joke %></h2>
          </div>
        </div>
      <% } %>

      <hr class="my-4" />

      <form action="/cocktail" method="POST" class="mb-4">
          <button type="submit" class="btn btn-primary w-100">Get a random cocktail!</button>
      </form>

      <% if (cocktail === "error") { %>
        <div class="alert alert-danger text-center" role="alert">
          The bartender has stepped away. Please try again!
        </div>
      <% } else if (cocktail !== null) { %>
        <div class="card mb-4 text-center">
          <div class="card-body">
            <h2 class="card-title fw-bold"><%= cocktail.name %></h2>
            <img src="<%= cocktail.image %>" class="img-fluid rounded my-3 shadow-sm" alt="<%= cocktail.name %>" style="max-width: 250px;" />
            <div class="text-start">
              <h3 class="h5 border-bottom pb-2">Ingredients:</h3>
              <ul class="text-secondary">
                <% cocktail.ingredients.forEach(function(item) { %>
                  <li><%= item %></li>
                <% }) %>
              </ul>
              <h3 class="h5 border-bottom pb-2 mt-3">Instructions:</h3>
              <p class="text-secondary"><%= cocktail.instructions %></p>
            </div>
          </div>
        </div>
      <% } %>

      <hr class="my-4" />

      <form action="/crypto" method="POST" class="mb-4">
          <button type="submit" class="btn btn-success w-100 fw-bold">Get Bitcoin Price</button>
      </form>
      
      <% if (crypto === "error") { %>
        <div class="alert alert-danger text-center" role="alert">
          Failed to fetch crypto data.
        </div>
      <% } else if (crypto !== null) { %>
        <div class="card text-center mb-4 border-success">
          <div class="card-body">
            <h2 class="h4 text-secondary">Bitcoin (BTC)</h2>
            <h1 class="text-success display-5 fw-bold my-3">$<%= crypto.price.toLocaleString() %></h1>
            
            <div class="mt-4" style="position: relative; height: 250px; width: 100%;">
              <canvas id="btcChart"></canvas>
            </div>
            <p class="text-muted small mt-2">30-Day Price History</p>
          </div>
        </div>
        
        <script>
          const ctx = document.getElementById('btcChart').getContext('2d');
          new Chart(ctx, {
            type: 'line',
            data: {
              labels: <%- JSON.stringify(crypto.labels) %>,
              datasets: [{
                label: 'Price (USD)',
                data: <%- JSON.stringify(crypto.prices) %>,
                borderColor: '#198754',
                backgroundColor: 'rgba(25, 135, 84, 0.1)',
                borderWidth: 2,
                pointRadius: 1,
                fill: true,
                tension: 0.3
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                y: { ticks: { callback: function(value) { return '$' + value; } } }
              }
            }
          });
        </script>
      <% } %>

    </main>

    <script>
      document.getElementById("detect-btn").addEventListener("click", () => {
        if (!navigator.geolocation) {
          alert("Geolocation is not supported by your browser.");
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (position) => {
            document.getElementById("lat").value = position.coords.latitude;
            document.getElementById("lng").value = position.coords.longitude;
          },
          (error) => {
            alert(`Error getting location: ${error.message}`);
          }
        );
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>